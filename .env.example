#   .env.example -> .env

# GitHub Personal Access Token w/ `user` scope (required)
GH_TOKEN=your_token_here

# GitHub username and password for browser automation (used as fallback or if API method fails)
GH_USERNAME=your_username_here
GH_PASSWORD=your_password_here

# Optional: GitHub TOTP secret for 2FA (if enabled)
#    easier to just disable 2FA for account
# GH_TOTP_SECRET=your_totp_secret_here

# Optional: URL to a valid PUBLIC Pinterest board
PINTEREST_SOURCE_BOARD=https://www.pinterest.com/username/board-name/

# Directory containing local fallback images (default: assets/profile_pictures)
PROFILE_PICTURE_DIR=assets/profile_pictures

# Target avatar size in pixels (GitHub max 512, default 512)
IMAGE_SIZE=512

# Enable debug mode for Playwright (headful browser, save artifacts)
# Set to 1, true, or yes to enable
DEBUG_PW=1