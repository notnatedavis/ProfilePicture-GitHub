#   .env.example

# GitHub personal access token with `user` scope (required)
GITHUB_TOKEN=your_token_here

# optional: URL to a valid PUBLIC Pinterest board
PINTEREST_SOURCE_BOARD=https://www.pinterest.com/username/board-name/

# directory containing local fallback images
PROFILE_PICTURE_DIR=assets/profile_pictures

# target avatar size in pixels (GitHub max 512)
IMAGE_SIZE=512